/* ===== Base ===== */
* { font-family: "Segoe UI", "Inter", Arial; }
QWidget { font-size: 11pt; color: #111827; background: #F8FAFC; }

/* ===== Inputs ===== */
QLineEdit, QComboBox {
  padding: 8px 10px;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  background: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus {
  border: 1px solid #3B82F6;
  outline: none;
}

/* QComboBox popup/lista */
QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  selection-background-color: #DBEAFE;
  padding: 6px;
  outline: 0;
}

/* ===== Botones ===== */
QPushButton {
  padding: 8px 14px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: #111827;   /* default */
  color: #FFFFFF;
}
QPushButton:hover {
  background: #1F2937; /* un poco más claro que #111827 */
  border: 1px solid #0B1220;
}
QPushButton:pressed {
  background: #0B1220;
  border: 1px solid #0B1220;
}
QPushButton:disabled {
  background: #9CA3AF;
  color: #F9FAFB;
}

/* Variantes con objectName */
QPushButton#PrimaryButton   { background: #3B82F6; }
QPushButton#PrimaryButton:hover  { background: #5BA0FF; border: 1px solid #2C6DCE; }
QPushButton#PrimaryButton:pressed{ background: #2C6DCE; border: 1px solid #2C6DCE; }

QPushButton#SecondaryButton { background: #111827; }
QPushButton#SecondaryButton:hover  { background: #1F2937; border: 1px solid #0B1220; }
QPushButton#SecondaryButton:pressed{ background: #0B1220; border: 1px solid #0B1220; }

QPushButton#DangerButton    { background: #EF4444; }
QPushButton#DangerButton:hover  { background: #F06262; border: 1px solid #C02F2F; }
QPushButton#DangerButton:pressed{ background: #C02F2F; border: 1px solid #C02F2F; }

/* ===== Tabla ===== */
QTableWidget {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  gridline-color: #E5E7EB;
}
QHeaderView::section {
  background: #F3F4F6;
  color: #111827;
  padding: 8px;
  border: none;
  font-weight: 600;
}
QTableWidget::item { padding: 8px; }
QTableWidget::item:selected { background: #DBEAFE; color: #111827; }
QTableWidget QTableCornerButton::section { background: #F3F4F6; border: none; }

/* Zebra (activa setAlternatingRowColors(True) en código) */
QTableView::item:!selected:alternate { background: #F9FAFB; }

/* ===== ListWidget ===== */
QListWidget {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
}
QListWidget::item { padding: 8px; }
QListWidget::item:selected { background: #DBEAFE; color: #111827; }

/* ===== Scrollbars ===== */
QScrollBar:vertical, QScrollBar:horizontal {
  background: transparent;
  border: none;
  margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: #D1D5DB;
  min-height: 24px;
  min-width: 24px;
  border-radius: 8px;
}
QScrollBar::handle:hover { background: #9CA3AF; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ===== MessageBox ===== */
QMessageBox { background: #FFFFFF; }
